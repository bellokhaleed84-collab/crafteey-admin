# 0. If this folder still has a remote pointing at the deleted repo, remove it first
git remote remove origin 2>/dev/null

# 1. Create the .gitignore (skip this if you already copied the one from the zip)
cat > .gitignore << 'EOF'
# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit secrets
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
EOF
